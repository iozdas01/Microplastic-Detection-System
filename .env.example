# ============================================================
# STARTUP ASSUMPTION LAB — API KEYS
#
# Copy to .env and fill in what you need. Never commit .env.
# Source of truth for which sources exist: api-registry.yaml.
# Every source not listed here is keyless — nothing to configure.
#
# `_common.is_enabled(key)` treats a missing env var as "source disabled",
# so an empty value here degrades gracefully; it never errors.
# ============================================================


# ─── Community & social ──────────────────────────────────────
# hacker_news_algolia, reddit_json — keyless.

# Self-hosted Firecrawl (infra/firecrawl/). Optional override; this is the default.
FIRECRAWL_BASE_URL=http://127.0.0.1:3002

# Reddit PRAW/OAuth. Optional enrichment only; the public JSON path is the default.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StartupLab/0.1 by YOUR_REDDIT_USERNAME


# ─── News & media ────────────────────────────────────────────
# gdelt_rest — keyless. BigQuery aggregates need a GCP service account
# (1 TB/month free tier).
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=


# ─── Web search ──────────────────────────────────────────────
# Exa AI (exa.ai — 20K searches/mo free). Ships disabled in api-registry.yaml.
EXA_API_KEY=


# ─── Jobs & labor ────────────────────────────────────────────
# Adzuna (developer.adzuna.com — free).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=


# ─── Company data ────────────────────────────────────────────
# gleif, edgar_fulltext — keyless.
# SEC asks that automated clients identify themselves; defaults to a repo
# address if unset.
EDGAR_USER_AGENT_EMAIL=

# Companies House UK (developer.company-information.service.gov.uk — free).
COMPANIES_HOUSE_API_KEY=


# ─── Procurement, grants, domain sources ─────────────────────
# ted_eu, uk_contracts_finder, sbir, cordis, elexon_bmrs, uswtdb — all keyless.
